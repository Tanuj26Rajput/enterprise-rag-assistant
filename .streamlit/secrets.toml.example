# Template for Streamlit Community Cloud's "Secrets" panel (App settings ->
# Secrets), or for a local `.streamlit/secrets.toml` when running
# `streamlit run streamlit_app.py` to test the single-process deployment
# before pushing it. Copy the keys you need; `streamlit_app.py` copies every
# one of them into the process environment, where the backend
# (app/core/config.py) reads them exactly as it does from a `.env` file.
#
# Never commit `.streamlit/secrets.toml` itself - only this example.

ENVIRONMENT = "production"
SECRET_KEY = "generate-a-random-32+-char-value"

# A database reachable from the internet - Streamlit Cloud has none of its
# own. A free Supabase or Neon Postgres project both work; use the
# *transaction pooler* URL (Supabase: port 6543) as DATABASE_URL, and the
# direct (non-pooled) URL as DATABASE_DIRECT_URL for migrations.
DATABASE_URL = "postgresql://user:password@host:6543/postgres"
DATABASE_DIRECT_URL = "postgresql://user:password@host:5432/postgres"

# Chat generation (OpenRouter by default - see app/core/config.py).
LLM_PROVIDER = "openrouter"
LLM_MODEL = "anthropic/claude-sonnet-5.5"
OPENROUTER_API_KEY = "sk-or-..."

# Embeddings (OpenAI by default; independent of the chat provider above).
EMBEDDING_PROVIDER = "openai"
EMBEDDING_MODEL = "text-embedding-3-small"
OPENAI_API_KEY = "sk-..."

# Restrict this to the app's own Streamlit Cloud URL once you know it; "*" is
# rejected in production (see Settings._enforce_production_hardening).
CORS_ORIGINS = "https://your-app-name.streamlit.app"
